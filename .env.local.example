# Articles: dev.to API key (optional) — used to fetch your published posts.
DEV_TO_API_KEY=

# GitHub page: your GitHub username (used to fetch repos and the contribution graph).
NEXT_PUBLIC_GITHUB_USERNAME=YilmazHilal

# --- Admin panel (/admin) ---

# Password required to sign in to the admin panel. REQUIRED for /admin to work.
ADMIN_PASSWORD=change-me

# Optional: dedicated secret used to sign admin session cookies.
# If omitted, ADMIN_PASSWORD is used to derive the signing key.
ADMIN_SESSION_SECRET=

# GitHub commit-back: with a token, saving in the admin panel commits the
# updated data/*.json back to the repo, which triggers a Vercel redeploy.
# Create a fine-grained Personal Access Token with "Contents: Read and write"
# scoped to this repository. Without a token, the admin panel writes to the
# local files instead (useful for `next dev`).
GITHUB_TOKEN=

# Optional repo targeting. On Vercel these fall back to the deployment's own
# repo/branch (VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG / VERCEL_GIT_COMMIT_REF),
# so in production you usually only need to set GITHUB_TOKEN.
GITHUB_OWNER=YilmazHilal
GITHUB_REPO=Hilal-Yilmaz-Portfolio
GITHUB_BRANCH=main
